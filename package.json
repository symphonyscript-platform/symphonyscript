{
  "name": "@symphonyscript/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build",
    "test": "turbo run test",
    "test:all": "turbo run test",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "dev": "pnpm --filter @symphonyscript/web dev",
    "web": "pnpm --filter @symphonyscript/web dev",
    "watch:kernel": "pnpm --filter @symphonyscript/kernel watch",
    "watch:theory": "pnpm --filter @symphonyscript/theory watch",
    "watch:notations": "pnpm --filter @symphonyscript/notations watch",
    "watch:core": "pnpm --filter @symphonyscript/core watch",
    "watch:synaptic": "pnpm --filter @symphonyscript/synaptic watch",
    "watch:composer": "pnpm --filter @symphonyscript/composer watch",
    "test:kernel": "pnpm --filter @symphonyscript/kernel test",
    "test:theory": "pnpm --filter @symphonyscript/theory test",
    "test:notations": "pnpm --filter @symphonyscript/notations test",
    "test:core": "pnpm --filter @symphonyscript/core test",
    "test:synaptic": "pnpm --filter @symphonyscript/synaptic test",
    "test:composer": "pnpm --filter @symphonyscript/composer test",
    "build:kernel": "pnpm --filter @symphonyscript/kernel build",
    "build:theory": "pnpm --filter @symphonyscript/theory build",
    "build:notations": "pnpm --filter @symphonyscript/notations build",
    "build:core": "pnpm --filter @symphonyscript/core build",
    "build:synaptic": "pnpm --filter @symphonyscript/synaptic build",
    "build:composer": "pnpm --filter @symphonyscript/composer build",
    "build:web": "turbo run build --filter=@symphonyscript/web && mkdir -p dist && cp packages/web/teaser.html dist/index.html",
    "compile:kernel:web": "cd packages/kernel && wasm-pack build --target web",
    "version": "pnpm changeset version",
    "publish:packages": "pnpm publish -r",
    "release": "pnpm build && pnpm changeset version && pnpm install && pnpm publish -r",
    "clean:files": "find . -type d -name \"src\" -prune -o -name \"*.d.ts\" -delete && find . -type d -name \"src\" -prune -o -name \"*.d.ts.map\" -delete",
    "clean:dist": "find . -name \"dist\" -type d -prune -exec rm -rf '{}' +",
    "clean:node_modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +"
  },
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-react": "^5.1.2",
    "dependency-cruiser": "^17.3.9",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.2.0",
    "jest-util": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.1",
    "tslib": "^2.8.1",
    "turbo": "^2.8.17",
    "typescript": "~5.9.2",
    "vite": "^7.3.0",
    "vite-plugin-custom-tsconfig": "^1.0.4",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "dependencies": {
    "orchestrator-relay": "^2.0.7"
  }
}
